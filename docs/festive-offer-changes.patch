+/* =========================================================================
+   FESTIVE OFFER (Dussehra) — warm gold on ink. Distinct from Halloween's red
+   on purpose, so the two offers are never confused. transform/opacity only.
+========================================================================= */
+.fo, .fo-banner {
+  --fo-gold: #c9a24a;
+  --fo-gold-soft: rgba(201, 162, 74, 0.14);
+  --fo-bone: #efe6dc;
+  --fo-dim: rgba(239, 230, 220, 0.66);
+}
+
+/* ── HOME SECTION ── */
+.fo {
+  position: relative;
+  color: var(--fo-bone);
+  background: radial-gradient(ellipse 80% 70% at 50% 0%, #1d160a 0%, #0f0c08 55%, #0a0806 100%);
+  padding: clamp(4rem, 8vw, 7rem) clamp(1.25rem, 5vw, 4rem);
+  border-top: 1px solid rgba(201, 162, 74, 0.25);
+  border-bottom: 1px solid rgba(201, 162, 74, 0.25);
+  overflow: hidden;
+}
+.fo::before { /* soft lamp-light glow */
+  content: ""; position: absolute; left: 50%; top: -30%; width: 90vw; max-width: 1100px; aspect-ratio: 1;
+  transform: translateX(-50%); pointer-events: none;
+  background: radial-gradient(closest-side, rgba(201, 162, 74, 0.16), transparent 70%);
+}
+.fo-inner { position: relative; max-width: 1100px; margin: 0 auto; text-align: center; }
+.fo-eyebrow {
+  font-family: "DM Mono", monospace; font-size: 0.66rem; letter-spacing: 0.32em; text-transform: uppercase;
+  color: var(--fo-gold); margin-bottom: 1.2rem;
+}
+.fo-title {
+  font-family: "Cormorant Garamond", serif; font-weight: 300; line-height: 1.04; letter-spacing: -0.01em;
+  font-size: clamp(2.3rem, 5.6vw, 4.4rem);
+}
+.fo-title em { font-style: italic; color: var(--fo-gold); }
+.fo-intro { max-width: 560px; margin: 1.4rem auto 0; font-size: 1rem; line-height: 1.8; color: var(--fo-dim); }
+
+.fo-clock {
+  display: inline-flex; flex-direction: column; align-items: center; gap: 0.35rem;
+  margin-top: 1.8rem; padding: 0.9rem 1.6rem; border: 1px solid rgba(201, 162, 74, 0.4);
+}
+.fo-clock-label { font-family: "DM Mono", monospace; font-size: 0.58rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--fo-dim); }
+.fo-clock-time {
+  font-family: "Cormorant Garamond", serif; font-size: 2rem; line-height: 1; color: var(--fo-gold);
+  font-variant-numeric: tabular-nums;
+}
+.fo-clock.is-live .fo-clock-time { color: #f3d98b; }
+
+.fo-tiers { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(0.8rem, 2vw, 1.5rem); margin-top: clamp(2.2rem, 5vw, 3.6rem); text-align: left; }
+.fo-tier {
+  position: relative; display: flex; flex-direction: column; gap: 0.5rem;
+  padding: clamp(1.4rem, 2.6vw, 2.2rem); border: 1px solid rgba(239, 230, 220, 0.16);
+  background: rgba(255, 255, 255, 0.025);
+  transition: border-color 0.4s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
+}
+.fo-tier:hover { border-color: var(--fo-gold); transform: translateY(-4px); }
+.fo-tier-tag { font-family: "DM Mono", monospace; font-size: 0.6rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--fo-gold); }
+.fo-tier-buy { font-family: "Cormorant Garamond", serif; font-weight: 400; font-size: 1.7rem; line-height: 1.1; }
+.fo-tier-off { font-family: "Cormorant Garamond", serif; font-weight: 300; font-size: clamp(2.6rem, 5vw, 3.8rem); line-height: 1; margin-top: 0.4rem; color: #f3d98b; }
+.fo-tier-price { font-family: "DM Mono", monospace; font-size: 0.78rem; letter-spacing: 0.06em; color: var(--fo-dim); }
+.fo-tier-note { margin-top: 0.4rem; font-family: "Cormorant Garamond", serif; font-style: italic; font-size: 1.15rem; color: var(--fo-gold); }
+.fo-tier--3 { border-color: var(--fo-gold); background: linear-gradient(160deg, rgba(201, 162, 74, 0.18), rgba(201, 162, 74, 0.04)); }
+.fo-tier--3::after {
+  content: "Best value"; position: absolute; top: -0.7rem; right: 1.2rem; padding: 0.25rem 0.7rem;
+  font-family: "DM Mono", monospace; font-size: 0.56rem; letter-spacing: 0.2em; text-transform: uppercase;
+  background: var(--fo-gold); color: #1a1408;
+}
+
+.fo-foot { margin-top: clamp(2rem, 4vw, 3rem); display: flex; flex-direction: column; align-items: center; gap: 1.2rem; }
+.fo-btn {
+  font-family: "DM Mono", monospace; font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase;
+  padding: 1rem 2.4rem; background: var(--fo-gold); color: #1a1408; border: 1px solid var(--fo-gold); cursor: none;
+  transition: background 0.25s, transform 0.25s;
+}
+.fo-btn:hover { background: #dbb55c; transform: translateY(-1px); }
+.fo-terms { max-width: 640px; font-size: 0.74rem; line-height: 1.7; color: rgba(239, 230, 220, 0.5); }
+
+/* ── PRODUCT-PAGE BANNER (light pages) ── */
+.fo-banner {
+  margin: 1.1rem 0 0.4rem; padding: 0.95rem 1.1rem; border: 1px solid var(--fo-gold);
+  background: var(--fo-gold-soft); color: #1b1710;
+}
+.fo-banner-head {
+  display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.4rem 1rem;
+  font-family: "DM Mono", monospace; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; color: #7a5c14;
+}
+.fo-banner-time { font-variant-numeric: tabular-nums; }
+.fo-banner-tiers { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; margin: 0.8rem 0 0.6rem; padding: 0; }
+.fo-banner-tiers li { display: flex; flex-direction: column; padding: 0.55rem 0.7rem; background: rgba(255, 255, 255, 0.55); border: 1px solid rgba(201, 162, 74, 0.4); }
+.fo-banner-tiers strong { font-family: "Cormorant Garamond", serif; font-size: 1.35rem; font-weight: 500; line-height: 1.1; }
+.fo-banner-tiers span { font-size: 0.7rem; color: #5b5444; }
+.fo-banner-note { font-size: 0.72rem; color: #5b5444; line-height: 1.5; }
+
+/* ── HOME CARDS / CART ── */
+.fo-card-tag {
+  display: inline-block; margin-top: 0.55rem; padding: 0.25rem 0.6rem;
+  font-family: "DM Mono", monospace; font-size: 0.54rem; letter-spacing: 0.16em; text-transform: uppercase;
+  color: #7a5c14; background: rgba(201, 162, 74, 0.16); border: 1px solid rgba(201, 162, 74, 0.5);
+}
+
+@media (max-width: 820px) {
+  .fo-tiers { grid-template-columns: 1fr; }
+  .fo-tier--3::after { right: 1rem; }
+  .fo-btn { cursor: pointer; }
+  .fo-banner-tiers { grid-template-columns: 1fr; }
+  .fo-banner-tiers li { flex-direction: row; align-items: baseline; justify-content: space-between; }
+}
+@media (prefers-reduced-motion: reduce) { .fo-tier { transition: none; } .fo-tier:hover { transform: none; } }
